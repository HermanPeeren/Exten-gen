<?xml version="1.0" encoding="utf-8"?>
<form>
  <fieldset addruleprefix="Yepr\Component\eventschedule\Administrator\Rule" addfieldprefix="Yepr\Component\eventschedule\Administrator\Field">
    <field name="name" type="text" format="%Y-%m-%d %H:%M" label="COM_EVENTSCHEDULE_SPEAKER_FIELD_NAME_LABEL" description="COM_EVENTSCHEDULE_SPEAKER_FIELD_NAME_DESC"/>
    <field name="biography" type="textarea" format="%Y-%m-%d %H:%M" label="COM_EVENTSCHEDULE_SPEAKER_FIELD_BIOGRAPHY_LABEL" description="COM_EVENTSCHEDULE_SPEAKER_FIELD_BIOGRAPHY_DESC"/>
    <field name="presentations" type="sql" query="SELECT id, `presentation_name` FROM `#__eventschedule_presentation`" header="&amp;nbsp;" key_field="id" value_field="presentation_name" label="COM_EVENTSCHEDULE_SPEAKER_FIELD_PRESENTATIONS_LABEL" description="COM_EVENTSCHEDULE_SPEAKER_FIELD_PRESENTATIONS_DESC"/>
    <field name="id" type="hidden"/>
  </fieldset>
</form>
