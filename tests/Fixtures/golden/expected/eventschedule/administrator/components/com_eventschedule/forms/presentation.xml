<?xml version="1.0" encoding="utf-8"?>
<form>
  <fieldset addruleprefix="Yepr\Component\eventschedule\Administrator\Rule" addfieldprefix="Yepr\Component\eventschedule\Administrator\Field">
    <field name="presentation_name" type="text" format="%Y-%m-%d %H:%M" label="COM_EVENTSCHEDULE_PRESENTATION_FIELD_PRESENTATION_NAME_LABEL" description="COM_EVENTSCHEDULE_PRESENTATION_FIELD_PRESENTATION_NAME_DESC"/>
    <field name="short_description" type="text" format="%Y-%m-%d %H:%M" label="COM_EVENTSCHEDULE_PRESENTATION_FIELD_SHORT_DESCRIPTION_LABEL" description="COM_EVENTSCHEDULE_PRESENTATION_FIELD_SHORT_DESCRIPTION_DESC"/>
    <field name="long_description" type="text" format="%Y-%m-%d %H:%M" label="COM_EVENTSCHEDULE_PRESENTATION_FIELD_LONG_DESCRIPTION_LABEL" description="COM_EVENTSCHEDULE_PRESENTATION_FIELD_LONG_DESCRIPTION_DESC"/>
    <field name="duration" type="number" format="%Y-%m-%d %H:%M" label="COM_EVENTSCHEDULE_PRESENTATION_FIELD_DURATION_LABEL" description="COM_EVENTSCHEDULE_PRESENTATION_FIELD_DURATION_DESC"/>
    <field name="locators" type="subform" formsource="administrator/components/com_eventschedule/forms/locator.xml" multiple="true" min="0" layout="joomla.form.field.subform.repeatable" label="COM_EVENTSCHEDULE_PRESENTATION_FIELD_LOCATORS_LABEL" description="COM_EVENTSCHEDULE_PRESENTATION_FIELD_LOCATORS_DESC"/>
    <field name="presentation_type" type="sql" query="SELECT id, `presentation_type_name` FROM `#__eventschedule_presentation_type`" header="&amp;nbsp;" key_field="id" value_field="presentation_type_name" label="COM_EVENTSCHEDULE_PRESENTATION_FIELD_PRESENTATION_TYPE_LABEL" description="COM_EVENTSCHEDULE_PRESENTATION_FIELD_PRESENTATION_TYPE_DESC"/>
    <field name="id" type="hidden"/>
  </fieldset>
</form>
