    <field name="daySchedule" type="sql" query="SELECT id, `name` FROM `#__eventschedule_dayschedule`" header="&amp;nbsp;" key_field="id" value_field="name" label="COM_EVENTSCHEDULE_LOCATOR_FIELD_DAYSCHEDULE_LABEL" description="COM_EVENTSCHEDULE_LOCATOR_FIELD_DAYSCHEDULE_DESC"/>
  </fieldset>
</form>
