    <field name="account" type="sql" query="SELECT id, `code` FROM `#__balloonledger_account`" header="&amp;nbsp;" key_field="id" value_field="code" label="COM_BALLOONLEDGER_ENTRYLINE_FIELD_ACCOUNT_LABEL" description="COM_BALLOONLEDGER_ENTRYLINE_FIELD_ACCOUNT_DESC" required="true"/>
    <field name="description" type="text" label="COM_BALLOONLEDGER_ENTRYLINE_FIELD_DESCRIPTION_LABEL" description="COM_BALLOONLEDGER_ENTRYLINE_FIELD_DESCRIPTION_DESC"/>
    <field name="debit" type="text" label="COM_BALLOONLEDGER_ENTRYLINE_FIELD_DEBIT_LABEL" description="COM_BALLOONLEDGER_ENTRYLINE_FIELD_DEBIT_DESC"/>
