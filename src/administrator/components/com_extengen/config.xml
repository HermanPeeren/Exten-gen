<?xml version="1.0" encoding="utf-8"?>
<config>
	<fieldset
		name="projects"
		label="COM_EXTENGEN_PROJECT_FIELD_CONFIG_INDIVIDUAL_PROJECTS_DISPLAY"
		description="COM_EXTENGEN_PROJECT_FIELD_CONFIG_INDIVIDUAL_PROJECTS_DESC"
		>
		<field
			name="show_project_name_label"
			type="list"
			label="COM_EXTENGEN_PROJECT_FIELD_NAME_SHOW_CATEGORY_LABEL"
			default="1"
			>
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>

		<field
			name="custom_fields_enable"
			type="radio"
			class="switcher"
			label="JGLOBAL_CUSTOM_FIELDS_ENABLE_LABEL"
			default="1"
			>
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>

		<field
			name="show_name"
			type="radio"
			label="COM_EXTENGEN_PROJECT_FIELD_PARAMS_NAME_LABEL"
			default="1"
			class="switcher"
			>
			<option value="0">JHIDE</option>
			<option value="1">JSHOW</option>
		</field>

	</fieldset>
	<!--
		Generation: step 5.6.

		Installing a generated extension straight onto this site is off by
		default and stays off unless an administrator turns it on, because a
		generated extension is code built from whatever is in the model -
		custom-code slots included. On a site where anybody but the
		administrator can edit a model, turning this on lets them install code.
		It is never offered on the site's frontend, whatever this says.
	-->
	<fieldset
		name="generation"
		label="COM_EXTENGEN_CONFIG_GENERATION_LABEL"
		>
		<field
			name="allow_install_warning"
			type="note"
			class="alert alert-danger"
			label="COM_EXTENGEN_CONFIG_ALLOW_INSTALL_WARNING_LABEL"
			description="COM_EXTENGEN_CONFIG_ALLOW_INSTALL_WARNING_DESC"
		/>

		<field
			name="allow_install"
			type="radio"
			layout="joomla.form.field.radio.switcher"
			label="COM_EXTENGEN_CONFIG_ALLOW_INSTALL_LABEL"
			description="COM_EXTENGEN_CONFIG_ALLOW_INSTALL_DESC"
			default="0"
			filter="integer"
			>
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>
	</fieldset>

	<fieldset
		name="permissions"
		label="JCONFIG_PERMISSIONS_LABEL"
		description="JCONFIG_PERMISSIONS_DESC"
		>
		<field
			name="rules"
			type="rules"
			label="JCONFIG_PERMISSIONS_LABEL"
			validate="rules"
			filter="rules"
			component="COM_EXTENGEN"
			section="component"
		/>
	</fieldset>
</config>
