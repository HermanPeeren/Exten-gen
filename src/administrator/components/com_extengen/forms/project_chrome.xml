<?xml version="1.0" encoding="utf-8"?>
<!--
	The half of a project that is a Joomla item rather than a model.

	Split from project.xml at 3.4. A project edited through an imported
	metalanguage needs these fields and that language's root form, and a
	project edited through ER1 needs these fields and project_er1.xml - so the
	built-in language and an imported one have exactly the same shape, and 3.5
	can replace the first with a package without touching anything above.

	3.2 recorded why this half is not generated: alias, published, access,
	catid, ordering and params are not derivable from a language at all.
-->
<form>
	<fieldset name="general"
		addruleprefix="Yepr\Component\Extengen\Administrator\Rule"
		addfieldprefix="Yepr\Component\Extengen\Administrator\Field"
	>
		<field
			name="id"
			type="number"
			label="JGLOBAL_FIELD_ID_LABEL"
			default="0"
			class="readonly"
			readonly="true"
		/>

		<field
			name="name"
			type="text"
			validate="Letter"
			class="validate-letter"
			label="COM_EXTENGEN_PROJECT_FIELD_NAME_LABEL"
			size="40"
			required="true"
		 />

		<!--
			Which metalanguage this project is written in: step 3.4.
		
			Chosen once, when the project is created, and read-only afterwards.
			The plan asked for the binding to be made visibly by the person making
			the model rather than inferred from whatever the component ships - and
			changing it later is not a setting, it is a different model: the forms
			that opened it would stop matching what is stored.
		
			An empty value is ER1, which is what every project made before this
			field existed is written in.
		-->
		<field
			name="metalanguage"
			type="metalanguage"
			label="COM_EXTENGEN_PROJECT_FIELD_METALANGUAGE_LABEL"
			description="COM_EXTENGEN_PROJECT_FIELD_METALANGUAGE_DESC"
			class="custom-select"
			size="1"
		/>

		<field
			name="alias"
			type="text"
			label="JFIELD_ALIAS_LABEL"
			size="45"
			hint="JFIELD_ALIAS_PLACEHOLDER"
		/>

		<field
			name="language"
			type="contentlanguage"
			label="JFIELD_LANGUAGE_LABEL"
			>
			<option value="*">JALL</option>
		</field>

		<field
			name="published"
			type="list"
			label="JSTATUS"
			default="1"
			id="published"
			class="custom-select-color-state"
			size="1"
			>
			<option value="1">JPUBLISHED</option>
			<option value="0">JUNPUBLISHED</option>
			<option value="2">JARCHIVED</option>
			<option value="-2">JTRASHED</option>
		</field>

		<field
			name="catid"
			type="categoryedit"
			label="JCATEGORY"
			extension="COM_EXTENGEN"
			addfieldprefix="Joomla\Component\Categories\Administrator\Field"
			default=""
		/>

		<field
			name="access"
			type="accesslevel"
			label="JFIELD_ACCESS_LABEL"
			size="1"
		/>

		<field
			name="checked_out"
			type="hidden"
			filter="unset"
		/>

		<field
			name="checked_out_time"
			type="hidden"
			filter="unset"
		/>

		<field
			name="ordering"
			type="ordering"
			label="JFIELD_ORDERING_LABEL"
			content_type="COM_EXTENGEN.extengen"
		/>
	</fieldset>



	<fields name="params" label="JGLOBAL_FIELDSET_DISPLAY_OPTIONS">
		<fieldset name="display" label="JGLOBAL_FIELDSET_DISPLAY_OPTIONS">
			<field
				name="show_name"
				type="radio"
				class="switcher"
				label="COM_EXTENGEN_PROJECT_FIELD_PARAMS_NAME_LABEL"
			>
				<option value="0">JHIDE</option>
				<option value="1">JSHOW</option>
			</field>

			<field
				name="project_layout"
				type="componentlayout"
				label="JFIELD_ALT_LAYOUT_LABEL"
				class="custom-select"
				extension="COM_EXTENGEN"
				view="project"
				useglobal="true"
			/>
		</fieldset>
	</fields>
</form>
