<?xml version="1.0" encoding="utf-8"?>
<!--
	ER1, as this component ships it: the model half of a project.

	The root form of the built-in metalanguage, in the same position an
	imported language's root classifier form occupies. 3.5 generates this
	from ER1 modelled in LionCore M3 and keeps the generated set, at which
	point this file goes and MetalanguageEntry::builtIn() goes with it.
-->
<form>
	<fieldset name="entities"
			addruleprefix="Yepr\Component\Extengen\Administrator\Rule"
			addfieldprefix="Yepr\Component\Extengen\Administrator\Field"
	>

		<field
				name="datamodel"
				type="subform"
				formsource="administrator/components/com_extengen/forms/entity.xml"
				multiple="true"
				buttons="add,remove"
				label="Entities"
				id="datamodel"
		/>

		<field
				name="pages"
				type="subform"
				formsource="administrator/components/com_extengen/forms/page.xml"
				multiple="true"
				min="1"
				buttons="add,remove"
				label="Pages"
				id="pages"
		/>

		<!-- todo: multiple extensions in 1 package -->
		<field
				name="extensions"
				type="subform"
				formsource="administrator/components/com_extengen/forms/extensions.xml"
				multiple="false"
				min="1"
				buttons="add,remove"
				label="Extensions"
				id="extensions"
		/>

		<field
				name="project_id"
				type="hidden"
		/>
	</fieldset>
</form>
