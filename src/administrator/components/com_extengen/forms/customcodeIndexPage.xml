<?xml version="1.0" encoding="utf-8"?>
<form>
	<fieldset
		addruleprefix="Yepr\Component\Extengen\Administrator\Rule"
		addfieldprefix="Yepr\Component\Extengen\Administrator\Field"
	>
		<!--
			Code the generator cannot write, kept in the model rather than in
			the output so that regenerating cannot destroy it. The slot says
			where it goes, and the slots on offer come from SlotCatalogue
			rather than from a list written here that would drift from it.
		-->
		<field
			name="slot"
			type="Slot"
			owner="Page"
			pagetype="indexpage"
			label="COM_EXTENGEN_CUSTOMCODE_SLOT_LABEL"
			description="COM_EXTENGEN_CUSTOMCODE_SLOT_DESC"
			id="slot"
			class="custom-select-color-state"
		/>

		<field
			name="code"
			type="textarea"
			label="COM_EXTENGEN_CUSTOMCODE_CODE_LABEL"
			description="COM_EXTENGEN_CUSTOMCODE_CODE_DESC"
			id="code"
			rows="8"
			cols="80"
			class="font-monospace"
		/>

		<field
			name="customcode_id"
			type="hidden"
		/>
	</fieldset>
</form>
