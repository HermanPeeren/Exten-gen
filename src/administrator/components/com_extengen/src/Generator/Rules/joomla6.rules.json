                "path": "extensions.component.manifest.license"
            },
            "company_namespace": {
                "path": "extensions.component.manifest.company_namespace"
            },
            "pageName": {
                "derive": "pageName"
            }
        }
    },
    {
        "id": "site.mvc.details.menuitem",
        "for": "frontendPages",
        "template": "component/components/com_componentname/tmpl/details/default.xml.twig",
        "target": "components/com_{componentName|lower}/tmpl/{pageName|lower}/default.xml",
        "when": [
            {
                "operator": "notEquals",
                "path": "page_type",
                "value": "indexpage"
            }
        ],
        "bind": {
            "componentName": {
                "derive": "componentName"
            },
            "pageName": {
                "derive": "pageName"
            }
        }
    },
    {
        "id": "site.mvc.display",
        "for": "root",
        "template": "component/components/com_componentname/src/Controller/DisplayController.php.twig",
        "target": "components/com_{componentName|lower}/src/Controller/DisplayController.php",
        "bind": {
            "componentName": {
                "derive": "componentName"
            },
            "projectName": {
                "path": "name"
            },
            "version": {
                "path": "extensions.component.manifest.version"
            },
            "copyright": {
                "path": "extensions.component.manifest.copyright"
            },
            "license": {
                "path": "extensions.component.manifest.license"
            },
            "company_namespace": {
                "path": "extensions.component.manifest.company_namespace"
            },
            "defaultView": {
                "derive": "defaultFrontendIndexPage"
            }
        }
    }
]
