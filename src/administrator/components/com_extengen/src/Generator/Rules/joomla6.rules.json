    {
        "id": "admin.entity.table",
        "for": "entities",
        "template": "component/administrator/components/com_componentname/src/Table/Table.php.twig",
        "target": "administrator/components/com_{componentName|lower}/src/Table/{entityName}Table.php",
        "when": [
            {
                "operator": "missing",
                "path": "isvalueobject"
            }
        ],
        "bind": {
            "componentName": {
                "derive": "componentNameUcfirst"
            },
            "projectName": {
                "derive": "projectNameUcfirst"
            },
            "version": {
                "path": "extensions.component.manifest.version"
            },
            "copyright": {
                "path": "extensions.component.manifest.copyright"
            },
            "license": {
                "path": "extensions.component.manifest.license"
            },
            "company_namespace": {
                "path": "extensions.component.manifest.company_namespace"
            },
            "entityName": {
                "derive": "entityNameUcfirst"
            },
            "slots": {
                "derive": "entitySlots"
            },
            "getFK": {
                "literal": ""
            },
            "m2m_bind": {
                "fragments": "manyToMany",
                "template": "component/administrator/components/com_componentname/src/Table/fragments/m2m_bind.php.twig"
            },
            "m2m_delete": {
                "fragments": "manyToMany",
                "template": "component/administrator/components/com_componentname/src/Table/fragments/m2m_delete.php.twig"
            },
            "m2m_localstore": {
                "fragments": "manyToMany",
                "template": "component/administrator/components/com_componentname/src/Table/fragments/m2m_localstore.php.twig"
            },
            "m2m_relatedstore": {
                "fragments": "manyToMany",
                "template": "component/administrator/components/com_componentname/src/Table/fragments/m2m_relatedstore.php.twig"
            }
        }
    },
