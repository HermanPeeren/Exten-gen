[
    {
        "id": "component.manifest",
        "for": "root",
        "template": "component/administrator/components/com_componentname/componentManifest.xml",
        "target": "{componentName|lower}.xml",
        "bind": {
            "componentName": {
                "derive": "componentNameUcfirst"
            },
            "projectName": {
                "path": "name"
            },
            "description": {
                "path": "extensions.component.component_description"
            },
            "backendIndexViews": {
                "derive": "backendIndexViews"
            },
            "defaultBackendView": {
                "derive": "defaultBackendView"
            },
            "author_name": {
                "path": "extensions.component.manifest.author_name"
            },
            "author_email": {
                "path": "extensions.component.manifest.author_email"
            },
            "author_url": {
                "path": "extensions.component.manifest.author_url"
            },
            "copyright": {
                "path": "extensions.component.manifest.copyright"
            },
            "license": {
                "path": "extensions.component.manifest.license"
            },
            "company_namespace": {
                "path": "extensions.component.manifest.company_namespace"
            },
            "version": {
                "path": "extensions.component.manifest.version"
            },
            "creation_date": {
                "path": "extensions.component.manifest.creation_date"
            }
        }
    },
    {
        "id": "admin.general.access",
