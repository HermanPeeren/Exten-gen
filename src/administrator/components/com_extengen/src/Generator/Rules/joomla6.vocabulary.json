{
    "target": "joomla6",
    "selectors": [
        "backendPages",
        "entities",
        "frontendPages",
        "root"
    ],
    "derivations": [
        "adminLinkPageName",
        "adminPageFilters",
        "adminPageForeign",
        "adminPagePropertyFieldNames",
        "backendIndexViews",
        "componentName",
        "componentNameUcfirst",
        "defaultBackendIndexPage",
        "defaultBackendView",
        "defaultFrontendIndexPage",
        "entityNameUcfirst",
        "entitySlots",
        "manyToMany",
        "pageEntityArray",
        "pageEntityName",
        "pageName",
        "pageSlots",
        "projectNameUcfirst",
        "siteDetailsForeign",
        "siteIndexFilters",
        "siteIndexForeign",
        "siteIndexPropertyFieldNames",
        "siteLinkPageName"
    ],
    "templates": [
        "LICENSE",
        "component/administrator/components/com_componentname/access.xml",
        "component/administrator/components/com_componentname/componentManifest.xml",
        "component/administrator/components/com_componentname/config.xml",
        "component/administrator/components/com_componentname/license_GPL3.txt",
        "component/administrator/components/com_componentname/services/provider.php.twig",
        "component/administrator/components/com_componentname/src/Controller/AdminDetailsController.php.twig",
        "component/administrator/components/com_componentname/src/Controller/AdminIndexController.php.twig",
        "component/administrator/components/com_componentname/src/Controller/DisplayController.php.twig",
        "component/administrator/components/com_componentname/src/Extension/ComponentnameComponent.php.twig",
        "component/administrator/components/com_componentname/src/Model/AdminDetailsModel.php.twig",
        "component/administrator/components/com_componentname/src/Model/AdminIndexModel.php.twig",
        "component/administrator/components/com_componentname/src/Table/Table.php.twig",
        "component/administrator/components/com_componentname/src/Table/fragments/m2m_bind.php.twig",
        "component/administrator/components/com_componentname/src/Table/fragments/m2m_delete.php.twig",
        "component/administrator/components/com_componentname/src/Table/fragments/m2m_localstore.php.twig",
        "component/administrator/components/com_componentname/src/Table/fragments/m2m_relatedstore.php.twig",
        "component/administrator/components/com_componentname/src/View/Details/HtmlView.php.twig",
        "component/administrator/components/com_componentname/src/View/Index/HtmlView.php.twig",
        "component/administrator/components/com_componentname/tmpl/details/edit.php.twig",
        "component/administrator/components/com_componentname/tmpl/index/default.php.twig",
        "component/components/com_componentname/src/Controller/DisplayController.php.twig",
        "component/components/com_componentname/src/Controller/SiteDetailsController.php.twig",
        "component/components/com_componentname/src/Controller/SiteIndexController.php.twig",
        "component/components/com_componentname/src/Model/SiteDetailsModel.php.twig",
        "component/components/com_componentname/src/Model/SiteIndexModel.php.twig",
        "component/components/com_componentname/src/View/Details/HtmlView.php.twig",
        "component/components/com_componentname/src/View/Index/HtmlView.php.twig",
        "component/components/com_componentname/tmpl/details/default.php.twig",
        "component/components/com_componentname/tmpl/details/default.xml.twig",
        "component/components/com_componentname/tmpl/index/default.php.twig",
        "component/components/com_componentname/tmpl/index/default.xml.twig"
    ],
    "operators": [
        "has",
        "missing",
        "equals",
        "notEquals"
    ],
    "bindingKinds": [
        "literal",
        "path",
        "node",
        "derive",
        "fragments"
    ],
    "pathFilters": [
        "lower",
        "upper",
        "ucfirst",
        "lcfirst"
    ],
    "selectorPaths": {
        "root": [],
        "entities": [
            {
                "contain": "datamodel"
            }
        ],
        "backendPages": [
            {
                "contain": "extensions"
            },
            {
                "contain": "component"
            },
            {
                "contain": "Sections"
            },
            {
                "contain": "backendsection"
            },
            {
                "follow": "page_reference",
                "to": "Page"
            }
        ],
        "frontendPages": [
            {
                "contain": "extensions"
            },
            {
                "contain": "component"
            },
            {
                "contain": "Sections"
            },
            {
                "contain": "frontendsection"
            },
            {
                "follow": "page_reference",
                "to": "Page"
            }
        ]
    }
}
