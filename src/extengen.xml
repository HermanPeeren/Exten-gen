<?xml version="1.0" encoding="utf-8" ?>
<extension type="component" method="upgrade">
	<name>com_extengen</name>
	<creationDate>26-09-2026</creationDate>
	<author>Herman Peeren</author>
	<authorEmail>herman@yepr.nl</authorEmail>
	<authorUrl>https://yepr.nl</authorUrl>
	<copyright>Yepr, Herman Peeren, 2022</copyright>
	<license>GNU General Public License version 3 or later;</license>
	<version>1.2.0</version>
	<description>COM_EXTENGEN_XML_DESCRIPTION</description>
	<namespace path="src">Yepr\Component\Extengen</namespace>
	<scriptfile>script.php</scriptfile>
	<install> <!-- Runs on install -->
		<sql>
			<file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
		</sql>
	</install>
	<uninstall> <!-- Runs on uninstall -->
		<sql>
			<file driver="mysql" charset="utf8">sql/uninstall.mysql.utf8.sql</file>
		</sql>
	</uninstall>
	<update>  <!-- Runs on update -->
		<schemas>
			<schemapath type="mysql">sql/updates/mysql</schemapath>
		</schemas>
	</update>
	<!-- Front-end files. No component-frontend, only media. -->
	<media folder="media/com_extengen" destination="com_extengen">
		<filename>joomla.asset.json</filename>
		<folder>js</folder>
	</media>
	<!-- Back-end files -->
	<administration>
		<!-- Menu entries -->
		<menu view="projects">COM_EXTENGEN</menu>
		<submenu>
			<menu link="option=com_extengen&amp;view=projects">COM_EXTENGEN_SUBMENU_MANAGER_PROJECTS</menu>
			<menu link="option=com_extengen&amp;view=generators">COM_EXTENGEN_SUBMENU_MANAGER_GENERATORS</menu>
			<menu link="option=com_extengen&amp;view=metalanguages">COM_EXTENGEN_SUBMENU_MANAGER_METALANGUAGES</menu>
			<menu link="option=com_extengen&amp;view=info">COM_EXTENGEN_SUBMENU_MANAGER_INFO</menu>
		</submenu>
		<files folder="administrator/components/com_extengen">
			<filename>access.xml</filename>
			<filename>config.xml</filename>
			<folder>forms</folder>
			<folder>language</folder>
			<folder>services</folder>
			<folder>sql</folder>
			<folder>generator_templates</folder>
			<folder>src</folder>
			<folder>tmpl</folder>
		</files>
	</administration>
	<changelogurl>https://raw.githubusercontent.com/hermanpeeren/extengen/changelog.xml</changelogurl>
	<updateservers>
		<server type="extension" name="Exten-gen Updates">https://raw.githubusercontent.com/HermanPeeren/Exten-gen/main/updates.xml</server>
	</updateservers>
</extension>
